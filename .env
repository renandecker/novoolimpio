# .env - credenciais reais para rodar via `docker compose up`.
# NAO faca commit deste arquivo em nenhum repositorio (adicione ao .gitignore).

# --- Banco de dados ---
# Fora do docker-compose (rodando com mvn/quarkus:dev na sua maquina), use localhost:
# DATABASE_URL=postgresql://localhost:5454/olimpio
# DATABASE_JDBC_URL=jdbc:postgresql://localhost:5454/olimpio
# Dentro do docker-compose o host correto e "postgres" (ja sobrescrito em docker-compose.yml).
DATABASE_URL=postgresql://localhost:5454/olimpio
DATABASE_JDBC_URL=jdbc:postgresql://localhost:5454/olimpio
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
FLYWAY_MIGRATE_AT_START=true

# --- Datasource JDBC default (Quarkus) ---
# Local (Compose): jdbc:postgresql://postgres:5432/olimpio
# Producao (standalone): jdbc:postgresql://216.238.106.140:5423/olimpio_novo
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres:5432/olimpio

# --- JWT (deve ser o MESMO segredo usado pelo olimpio-basico-service) ---
JWT_SECRET=c15adeeb3eecd9aa081e575a1b702bab0aa49e068150a80ee64468e3aadd9d5a

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Fiserv Commerce Hub / Payments Gateway (Developer Studio) ---
# Sandbox: https://cert.emea.api.fiservapps.com  |  Producao: https://prod.emea.api.fiservapps.com
FISERV_BASE_URL=https://cert.emea.api.fiservapps.com
FISERV_API_KEY=RGkq5yaacHoXmvqJGqdHxziacmhhhSbXZlLOnxGVYMvQyfTy
FISERV_API_SECRET=w58j8cHQ05Y8kRAeWGj8jVVUzGTo4dl8wJQOVO7GwA8hP31fKsuVy4Jd8xxMgUBV
FISERV_STORE_ID=
FISERV_CURRENCY=BRL
FISERV_TIMEOUT_MS=15000

QUARKUS_HTTP_PORT=8085

# --- Push Notifications (optional) ---
FCM_SERVER_KEY=dummy-fcm-key
APNS_KEY_ID=dummy-key-id
APNS_TEAM_ID=dummy-team-id
APNS_BUNDLE_ID=br.com.sol7.olimpio
APNS_PRIVATE_KEY=dummy-private-key
APNS_USE_SANDBOX=true

