# .env - credenciais reais para rodar via `docker compose up`.
# NAO faca commit deste arquivo em nenhum repositorio (adicione ao .gitignore).

# --- Banco de dados ---
# Fora do docker-compose (rodando com mvn/quarkus:dev na sua maquina), use localhost:
# DATABASE_URL=postgresql://localhost:5454/olimpio
# DATABASE_JDBC_URL=jdbc:postgresql://localhost:5454/olimpio
# Dentro do docker-compose o host correto e "postgres" (ja sobrescrito em docker-compose.yml).
DATABASE_URL=postgresql://localhost:5454/olimpio
DATABASE_JDBC_URL=jdbc:postgresql://localhost:5454/olimpio
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
FLYWAY_MIGRATE_AT_START=true

# --- JWT (deve ser o MESMO segredo usado pelo olimpio-basico-service) ---
JWT_SECRET=c15adeeb3eecd9aa081e575a1b702bab0aa49e068150a80ee64468e3aadd9d5a

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

