# Olimpio pagamento-service - variaveis de ambiente
# Copie para .env e preencha. Quarkus usa as mesmas variaveis do docker-compose.

# HTTP
QUARKUS_HTTP_PORT=8085

# Banco de dados (mesmo banco 'olimpio', schema compartilhado)
DATABASE_URL=postgresql://localhost:5454/olimpio
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_JDBC_URL=jdbc:postgresql://localhost:5454/olimpio

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Fiserv Commerce Hub / Payments Gateway (IPP) - Developer Studio
FISERV_BASE_URL=https://cert.emea.api.fiservapps.com
FISERV_API_KEY=
FISERV_API_SECRET=
FISERV_STORE_ID=
FISERV_CURRENCY=BRL
FISERV_TIMEOUT_MS=15000

# Fluxo PIX movido para o asaas-service (rota /api/asaas/pix) - ver envs do microsservico asaas.
